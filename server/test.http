# ==========================================
# 🛠️ API Test Suite - Smart Shade System
# ==========================================

@baseUrl = http://localhost:3001/api
@authToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

/**
 * @test    Authentication
 * @desc    Exchange admin credentials for a valid JWT token.
 * @route   POST /api/auth/login
 * @access  Public
 */
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "username": "admin",
    "password": "password123"
}

###

/**
 * @test    Sensor Data Ingestion
 * @desc    Simulate a physical IoT sensor sending raw data to the server.
 * @route   POST /api/sensors
 * @access  Public (Hardware Access)
 */
POST {{baseUrl}}/sensors
Content-Type: application/json

{
    "area_id": 1,
    "temperature": 25.0,
    "light_intensity": 800
}

###

/**
 * @test    Sensor History Retrieval
 * @desc    Fetch historical logs for a specific area to populate frontend charts.
 * @route   GET /api/sensors/history/:areaId
 * @access  Private (Requires Bearer Token)
 */
GET {{baseUrl}}/sensors/history/1
Authorization: Bearer {{authToken}}

###

/**
 * @test    Get All Areas
 * @desc    Retrieve the list of all monitored rooms and their current shade states.
 * @route   GET /api/areas
 * @access  Private (Requires Bearer Token)
 */
GET {{baseUrl}}/areas
Authorization: Bearer {{authToken}}
###

/**
 * @test    Create Mission
 * @desc    Define a recurring maintenance mission with its subtask checklist.
 * @route   POST /api/missions
 * @access  Private (Admin & Maintenance)
 */
POST {{baseUrl}}/missions
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
    "area_id": 1,
    "title": "Quarterly shade service",
    "description": "Full mechanical inspection",
    "frequency_days": 90,
    "scheduled_date": "2026-09-01",
    "subtasks": ["Clean rails", "Test motor", "Check sensor calibration"]
}

###

/**
 * @test    Daily Missions
 * @desc    Fetch the current user's missions due today.
 * @route   GET /api/missions?scope=today
 * @access  Private (Requires Bearer Token)
 */
GET {{baseUrl}}/missions?scope=today
Authorization: Bearer {{authToken}}

###

/**
 * @test    Fail a Subtask
 * @desc    Mark a subtask as blocked. Automatically opens a service ticket.
 * @route   PUT /api/missions/subtasks/:id
 * @access  Private (Assigned worker, or manager)
 */
PUT {{baseUrl}}/missions/subtasks/1
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
    "status": "Failed",
    "comment": "Motor seized — replacement part on order"
}

###

/**
 * @test    Finish Mission
 * @desc    Completes and reschedules, or escalates to the manager on failure.
 * @route   PUT /api/missions/:id/complete
 * @access  Private (Assigned worker, or manager)
 */
PUT {{baseUrl}}/missions/1/complete
Authorization: Bearer {{authToken}}

###

/**
 * @test    Close Day
 * @desc    Roll all still-open missions over to tomorrow.
 * @route   POST /api/missions/close-day
 * @access  Private (Requires Bearer Token)
 */
POST {{baseUrl}}/missions/close-day
Authorization: Bearer {{authToken}}

###

/**
 * @test    Approve Guide
 * @desc    Publish a pending knowledge-base guide to all users.
 * @route   PUT /api/guides/:id/review
 * @access  Private (Admin & Maintenance)
 */
PUT {{baseUrl}}/guides/1/review
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
    "status": "Approved"
}
