# Global Git configuration for file handling and line-ending normalization.
# Ensures compatibility between Windows (CRLF) and Linux/Docker (LF) environments.
#
# Note: .gitattributes only supports "#" comments. Block comments are parsed as
# patterns and rejected, which is what this file used to do on every git command.

# Auto-detect text files and perform LF normalization on commit.
* text=auto

# Linux/Docker compatibility: force LF for scripts and config files, so they do
# not fail to execute inside containers.
*.sh text eol=lf
*.js text eol=lf
*.json text eol=lf
*.css text eol=lf
.env* text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf

# Binary assets are never touched by text normalization.
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.svg text eol=lf
*.pdf binary
