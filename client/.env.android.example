# Configuration for the Android build: `npm run build:android`
#
# The packaged app has no dev-server proxy, so these MUST be absolute URLs
# pointing at a server the phone can actually reach:
#   - Cloudflare tunnel (https://...trycloudflare.com)  <- easiest for testing
#   - your EC2/production host
#   - your LAN IP (http://192.168.x.x:3001) — cleartext, dev only
VITE_API_URL=https://your-server.example.com/api
VITE_SOCKET_URL=https://your-server.example.com
