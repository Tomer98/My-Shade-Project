# Copy to server/.env and fill in. Never commit the filled-in file.

# ── Server ──────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
# Origin allowed by CORS and used to build password-reset links
CLIENT_URL=http://localhost:5173

# ── Database ────────────────────────────────────────────────────────────
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=

# ── Authentication ──────────────────────────────────────────────────────
# Any long random string. Changing it invalidates every issued token.
JWT_SECRET=

# ── Weather API ─────────────────────────────────────────────────────────
WEATHER_API_KEY=
WEATHER_CITY=Holon,IL

# ── Object storage (photo evidence on subtasks) ─────────────────────────
# S3 or any S3-compatible endpoint.
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Outgoing mail (password reset) ──────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# ── Demo seeding — scripts/seed_demo.js ─────────────────────────────────
# Password given to every seeded account. If unset, a random one is
# generated and printed once when the script finishes.
DEMO_PASSWORD=
# Mailbox for the seeded admin. Set it to an address you own if you want to
# demo the password-reset mail arriving; otherwise a placeholder is used.
DEMO_ADMIN_EMAIL=

# ── Sensor simulator — scripts/multi_simulator.js ───────────────────────
# Only needed when the simulator discovers rooms itself; passing room ids on
# the command line skips the login entirely.
SIM_API_BASE=http://localhost:3001/api
SIM_USER=
SIM_PASS=
